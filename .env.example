# ============================================================
#  RadFlow — пример переменных окружения
#  Скопируйте этот файл в .env.local и впишите реальные значения.
#  .env.local НЕ попадает в GitHub (см. .gitignore).
#  Эти же значения позже добавьте в Vercel → Settings → Environment Variables.
# ============================================================

# ----- Supabase (база данных + авторизация + файлы) -----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Серверный ключ (секретный, НЕ публичный) — только для серверного кода
SUPABASE_SERVICE_ROLE_KEY=

# ----- AI (пересчёт очереди / парсинг прайса) -----
# Дешёвая модель достаточно. Нужен один из двух.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- n8n Cloud (автоматизации) — ПОКА НЕ ПОДКЛЮЧЕНО -----
# n8n ещё не реализован. Пока N8N_WEBHOOK_URL пуст, события копятся durable в
# таблице event_outbox и никуда не шлются (доставка — no-op). Когда будешь
# подключать n8n — заполни адрес webhook, тогда же задай секреты ниже и включи
# джоб outbox-deliver в supabase/cron_jobs.sql.
#
# ВАЖНО: payload аварийного события содержит ФИО и телефоны пациентов, поэтому
# доставка fail-closed (lib/outbox.ts): без N8N_WEBHOOK_SECRET и без https://
# события НЕ отправляются вообще (роут /api/outbox/deliver вернёт 500).
# Адрес обязан быть https (исключение — localhost для локальной отладки).
N8N_WEBHOOK_URL=
# Общий секрет для HMAC-подписи событий outbox (X-RadFlow-Signature: sha256=hex);
# в n8n проверяй той же строкой и ОТКЛОНЯЙ запросы с неверной подписью — иначе
# твой webhook сможет вызвать кто угодно. ОБЯЗАТЕЛЕН вместе с N8N_WEBHOOK_URL.
N8N_WEBHOOK_SECRET=
# Защита cron-роута /api/outbox/deliver (Vercel Cron шлёт Authorization: Bearer).
# Нужен только когда n8n подключён и cron возвращён в vercel.json.
CRON_SECRET=

# ----- Email (Resend) -----
RESEND_API_KEY=

# ----- Мониторинг (Sentry) — опционально -----
SENTRY_DSN=
