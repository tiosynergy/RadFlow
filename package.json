{
  "name": "radflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migration-gate.mjs --build && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:gate": "node scripts/migration-gate.mjs",
    "db:gate:check": "node scripts/migration-gate.mjs --check",
    "test": "vitest run",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "test:watch": "vitest",
    "sync-board": "node scripts/sync-board.mjs",
    "seed:cities": "node scripts/seed-cities.mjs",
    "seed:testdata": "node scripts/seed-test-data.mjs",
    "gen:schedule-contract": "node scripts/gen-schedule-contract-sql.mjs",
    "docs:pdf": "node scripts/build-partner-pdf.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.0",
    "google-auth-library": "^11.0.2",
    "jszip": "^3.10.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
